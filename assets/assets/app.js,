var client = ZAFClient.init();

// Debug: show init status immediately
document.addEventListener('DOMContentLoaded', function() {
  var status = document.getElementById('account-status');
  if (status) {
    status.style.display = 'block';
    status.className = 'account-status loading';
    status.textContent = 'App loaded. ZAF initialising...';
  }

  // Bind button directly
  var btn = document.getElementById('validate-btn');
  if (btn) {
    btn.addEventListener('click', function() {
      var status = document.getElementById('account-status');
      status.style.display = 'block';
      status.className = 'account-status loading';
      status.textContent = 'Button clicked. Looking up account...';
      doLookup();
    });
  }

  var form = document.getElementById('account-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      doLookup();
    });
  }
});

client.on('app.registered', function() {
  client.invoke('resize', { width: '100%', height: '600px' });
  var status = document.getElementById('account-status');
  if (status) {
    status.style.display = 'block';
    status.className = 'account-status loading';
    status.textContent = 'ZAF ready. Enter account number and click Confirm.';
  }
});

function doLookup() {
  var input = document.getElementById('account-input');
  var status = document.getElementById('account-status');
  if (!input || !input.value.trim()) {
    status.style.display = 'block';
    status.className = 'account-status error';
    status.textContent = 'Please enter an account number.';
    return;
  }
  var accountNumber = input.value.trim();
  status.style.display = 'block';
  status.className = 'account-status loading';
  status.textContent = 'Searching for account ' + accountNumber + '...';

  client.request({
    url: '/api/v2/custom_objects/fdcustomeraccount/records/search?query=' + encodeURIComponent(accountNumber),
    type: 'GET'
  }).then(function(data) {
    var records = data.custom_object_records || [];
    status.textContent = 'Found ' + records.length + ' records. Checking match...';
    var match = null;
    records.forEach(function(r) {
      if (r.custom_object_fields.account_number === accountNumber) {
        match = r;
      }
    });
    if (match) {
      status.className = 'account-status loading';
      status.textContent = 'Match found: ' + match.name + '. Depot ID: ' + match.custom_object_fields.assigned_depot;
    } else {
      status.className = 'account-status error';
      status.textContent = 'No match found in ' + records.length + ' records for account ' + accountNumber;
    }
  }).catch(function(err) {
    status.className = 'account-status error';
    status.textContent = 'API error: ' + JSON.stringify(err);
  });
}
